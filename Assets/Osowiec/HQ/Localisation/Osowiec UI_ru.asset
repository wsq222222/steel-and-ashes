    m_Localized: "\u041E\u0442 \u043B\u0430\u0437\u0430\u0440\u0435\u0442\u0430 \u043A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443 \u0432\u0435\u0434\u0451\u0442 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0439 \u0445\u043E\u0434. \u0418\u0437 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0430\u043D\u0448\u0435\u0438 \u0438\u0434\u0438\u0442\u0435 \u043F\u043E \u043D\u0430\u0441\u0442\u0438\u043B\u0443 \u0434\u043E \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438. \u0417\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043E\u043C \u0432 \u043D\u0438\u0437\u0438\u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u043C\u0430\u0441\u043A\u0430. \u0417\u0430\u0440\u044F\u0434 \u0443 \u0434\u0432\u0435\u0440\u0438 \u043A\u0430\u0437\u0435\u043C\u0430\u0442\u0430 [E] \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442 \u0442\u0440\u0435\u0432\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 51949582934016
    m_Localized: "\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0442\u0440\u0430\u043D\u0448\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 51949582934017
    m_Localized: "\u041E\u0442 \u043B\u0430\u0437\u0430\u0440\u0435\u0442\u0430 \u0432\u043F\u0435\u0440\u0451\u0434, \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u043A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 51949582934018
    m_Localized: "\u041F\u043E \u043D\u0430\u0441\u0442\u0438\u043B\u0443 \u0434\u043E \u0438\u0437\u0433\u0438\u0431\u0430 \u0442\u0440\u0430\u043D\u0448\u0435\u0438, \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043E \u043A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 51949582934019
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u043E\u0439\u0446\u0430 \u0438 \u0443\u043A\u0430\u0436\u0438\u0442\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u043D\u0430 \u043A\u0430\u0440\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 59219725246464
    m_Localized: "Q \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0438\u0441\u043A\u043E\u043F. \u041B\u041A\u041C \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 \u0434\u0432\u0430 \u0445\u043E\u0434\u0430 (+20% \u0443\u0440\u043E\u043D\u0430 \u043E\u0442 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A). \u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u0441\u0432\u043E\u0439 \u0445\u043E\u0434 \u0431\u0435\u0437 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0438 \u0430\u0442\u0430\u043A\u0438: \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0441 10 \u043C \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \xD72. \u041F\u0440\u0435\u0434\u0435\u043B \u0443\u0440\u043E\u043D\u0430 \u2014 84, \u043F\u043E \u043A\u0430\u0441\u043A\u0435 \u2014 24."
    m_Metadata:
      m_Items: []
  - m_Id: 59219813326848
    m_Localized: "Q \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 6 \u043C. \u041F\u043E\u0441\u043B\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430 \u0413\u043E\u043D\u0447\u0430\u044F \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0439\u0442\u0438 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u043C\u0435\u0442\u0440\u044B. \u0417\u0430 \u0445\u043E\u0434 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u043E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B."
