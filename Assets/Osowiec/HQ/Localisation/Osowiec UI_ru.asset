  - m_Id: 3702513664
    m_Localized: "\u0423 \u043B\u0430\u0437\u0430\u0440\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3702513665
    m_Localized: "\u0417\u0430\u043F\u0430\u0434\u043D\u044B\u0439 \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 3702513666
    m_Localized: "\u0423 \u043D\u0438\u0437\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3702513667
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u043E\u0439\u0446\u0430 \u0438 \u0443\u043A\u0430\u0436\u0438\u0442\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u0441\u043E \u0437\u043D\u0430\u043A\u043E\u043C +."
    m_Metadata:
      m_Items: []
  - m_Id: 3702513668
    m_Localized: "{0} \xB7 \u043F\u0440\u0430\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430 \u0438\u043B\u0438 Delete, \u0447\u0442\u043E\u0431\u044B \u0441\u043D\u044F\u0442\u044C \u0431\u043E\u0439\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3702513669
    m_Localized: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 Enter, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0431\u043E\u0439\u0446\u0430."
