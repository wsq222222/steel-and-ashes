      m_Items: []
  - m_Id: 3702513671
    m_Localized: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 Q, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0434\u043B\u0438\u043D\u0443 \u043F\u0440\u044B\u0436\u043A\u0430. \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u043B\u044F \u043F\u0440\u044B\u0436\u043A\u0430 \u0438\u043B\u0438 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u043A\u0438 \u043F\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u0438. \u0412\u044B\u0441\u0442\u0440\u0435\u043B \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3702513672
    m_Localized: "Q \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0435\u0440\u0438\u0441\u043A\u043E\u043F. \u041B\u041A\u041C \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 \u0434\u0432\u0430 \u0445\u043E\u0434\u0430. \u041E\u0442\u0440\u044F\u0434 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0439 \u0446\u0435\u043B\u0438 \u043D\u0430 20% \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u0438\u0437 \u0432\u0438\u043D\u0442\u043E\u0432\u043E\u043A. \u041F\u043E\u0441\u043B\u0435 \u0441\u0432\u043E\u0435\u0433\u043E \u0445\u043E\u0434\u0430 \u0431\u0435\u0437 \u0430\u0442\u0430\u043A\u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0441 10 \u043C \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0443\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 3702513673
    m_Localized: "Q \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 4 \u043C\u0435\u0442\u0440\u0430 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u041C\u043E\u0436\u043D\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C \u0432 \u0442\u043E\u043C \u0436\u0435 \u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
