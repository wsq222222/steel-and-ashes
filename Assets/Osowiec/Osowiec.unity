      m_Calls: []
  m_text: "\u0426\u0415\u041B\u042C \u0418\u0413\u0420\u042B:\n\n\u0423\u043D\u0438\u0447\u0442\u043E\u0436\u044C\u0442\u0435 \u043A\u043E\u0440\u043E\u043B\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430, \u043D\u0435 \u0434\u0430\u0432 \u0435\u043C\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u0441 \u0432\u0430\u0448\u0438\u043C \u043A\u043E\u0440\u043E\u043B\u0435\u043C.\n\n\u041A\u0410\u041A \u0418\u0413\u0420\u0410\u0422\u042C:\n\n\u2022 \u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043D\u0430 \u0441\u0432\u043E\u0435\u0433\u043E \u044E\u043D\u0438\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0435\u0433\u043E\n\u2022 \u0412\u044B \u043F\u0435\u0440\u0435\u0439\u0434\u0435\u0442\u0435 \u0432 \u0440\u0435\u0436\u0438\u043C \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430\n\u2022 \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u044E\u043D\u0438\u0442\u043E\u043C \u0438 \u0430\u0442\u0430\u043A\u0443\u0439\u0442\u0435 \u0432\u0440\u0430\u0433\u043E\u0432\n\n\u0412\u044B \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u0431\u043E\u0442\u0430. \u0425\u043E\u0434\u044B \u0447\u0435\u0440\u0435\u0434\u0443\u044E\u0442\u0441\u044F.\n"
